{
  "name": "linden-bsp",
  "version": "1.0.0",
  "description": "Linden BSP - Board Support Package library for camera and common utilities",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "linden-logger"
    },
    {
      "name": "spdlog",
      "version>=": "1.17.0"
    },
    {
      "name": "opencv",
      "default-features": false,
      "features": ["core", "imgcodecs", "imgproc", "video", "videoio"]
    }
  ],
  "features": {
    "hik": {
      "description": "Enable Hikvision camera driver support (requires MVS SDK installed at /opt/MVS or $MVCAM_SDK_PATH)",
      "dependencies": []
    }
  },
  "default-features": ["hik"]
}
